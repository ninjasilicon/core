# ── Maersk Scraper — Environment Configuration ─────────────────────────────
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# ── Database (MySQL / MariaDB) ──────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_NAME=maersk_schedules
DB_USER=root
DB_PASSWORD=your_password_here

# ── Browser ─────────────────────────────────────────────────────────────────
# Set to false to open a visible browser window (useful for debugging)
HEADLESS=true

# How long to wait for the browser/page to respond (milliseconds)
BROWSER_TIMEOUT_MS=60000

# Extra settle time after search results appear (milliseconds)
RESULTS_WAIT_MS=8000

# ── Scraper ──────────────────────────────────────────────────────────────────
# Delay between consecutive searches to avoid rate-limiting (seconds)
REQUEST_DELAY_S=3.0

# Optional: custom User-Agent string (leave blank to use Playwright default)
USER_AGENT=
